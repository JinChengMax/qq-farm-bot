# 默认只运行农场服务，适合低配置机器。
NAPCAT_LOGIN_ENABLED=false

# 开启 NapCat：取消下列注释。首次启动会自动生成内部 Token。
# COMPOSE_PROFILES=napcat
# NAPCAT_LOGIN_ENABLED=true
# 使用 ./compose.sh 启动时会自动读取宿主机名称；需要覆盖时再取消注释。
# NAPCAT_DEVICE_NAME=QQ-Farm-NapCat

# 这些官方镜像均为 Linux 容器，同时提供 amd64 和 arm64。
# Intel/AMD Linux、Intel Mac 使用 linux/amd64；ARM Linux、Apple Silicon Mac 使用 linux/arm64。
# 官方不提供 32 位 x86 (linux/386)。
NAPCAT_IMAGE=mlikiowa/napcat-docker:v4.18.19
# NAPCAT_IMAGE=mlikiowa/napcat-docker:latest

# 复用独立 YYB-Go 已扫码账号（值须与 YYB-Go 的 YYB_INTEGRATION_TOKEN 相同）。
# 默认通过宿主机已发布的 8000 端口访问；共享 Docker 网络时也可使用 http://yyb-go:8000。
# YYB_GO_URL=http://host.docker.internal:8000
# YYB_GO_TOKEN=请生成一段高强度随机字符串
# YYB_GO_TIMEOUT_MS=15000
